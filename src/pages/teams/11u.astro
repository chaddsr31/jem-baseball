---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const roster = [
  { number: '00', name: 'Isaiah McPherson' },
  { number: '29', name: 'Sebastian Cobb' },
  { number: '33', name: 'John Cross' },
  { number: '34', name: 'Blake Jones' },
  { number: '35', name: 'Odie Hoover' },
  { number: '36', name: 'DJ Brown' },
  { number: '37', name: 'Julius Berrini' },
  { number: '38', name: 'Langston Miller' },
  { number: '39', name: 'David Sparkman' },
  { number: '40', name: 'Jeremiah Hampton' },
  { number: '41', name: 'Miles Merritt' },
  { number: '42', name: 'CJ Tate' },
  { number: '43', name: 'Tyrone Stevens' },
  { number: '45', name: 'Justin Horton' },
  { number: '46', name: 'Tristian Dixon' },
  { number: '48', name: 'Roman Rojas' },
];

const staff = ['Kyell Alexander', 'Nico Berrini', 'Jennifer Hoover', 'Tina Jones'];
---

<Layout title="11U Roster | JEM Baseball Training">
  <h1 class="page-title">11U Roster</h1>
  <p class="roster-season">Fall 2026</p>

  <div class="roster-layout">
    <div class="roster-photo">
      {
        /* TODO: replace with the real team photo, e.g.
           <img src={`${base}/images/teams/11u-team.jpg`} alt="11U Team Photo" /> */
      }
      <div class="roster-photo-placeholder">
        <span class="roster-photo-icon" aria-hidden="true">📷</span>
        <p>Team photo coming soon</p>
      </div>
    </div>

    <div class="roster-table-wrap">
      <table class="roster-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Player</th>
          </tr>
        </thead>
        <tbody>
          {
            roster.map((p) => (
              <tr>
                <td>{p.number}</td>
                <td>{p.name}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <section class="roster-staff">
    <h2 class="roster-staff-title">Coaching Staff</h2>
    <p>{staff.join(' · ')}</p>
  </section>

  <div class="prose" style="text-align: center;">
    <p>
      Questions? Email
      <a href="mailto:jembaseballtraining@gmail.com">jembaseballtraining@gmail.com</a>
    </p>
    <p><a href={`${base}/teams`}>&larr; Back to Teams</a></p>
  </div>
</Layout>

<style>
  .roster-season {
    text-align: center;
    font-family: var(--font-sans);
    color: var(--jem-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: -1.25rem 0 2rem;
  }

  .roster-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    max-width: 42rem;
    margin: 0 auto 2.5rem;
  }

  .roster-photo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    aspect-ratio: 4 / 3;
    background: var(--jem-surface);
    border: 1px dashed var(--jem-gold);
    border-radius: 4px;
    color: var(--jem-text-muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-align: center;
    padding: 1rem;
  }

  .roster-photo-icon {
    font-size: 2.25rem;
    opacity: 0.7;
  }

  .roster-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--jem-gold);
    border-radius: 4px;
  }

  .roster-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .roster-table th {
    text-align: left;
    padding: 0.55rem 1rem;
    background: var(--jem-gold);
    color: var(--jem-on-accent);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .roster-table th:first-child,
  .roster-table td:first-child {
    width: 3.5rem;
    text-align: center;
  }

  .roster-table td {
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--jem-border);
  }

  .roster-table tr:last-child td {
    border-bottom: none;
  }

  .roster-staff {
    text-align: center;
    font-family: var(--font-sans);
    margin-bottom: 2.5rem;
  }

  .roster-staff-title {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--jem-gold);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 640px) {
    .roster-layout {
      grid-template-columns: 1fr;
      max-width: 24rem;
    }
  }
</style>

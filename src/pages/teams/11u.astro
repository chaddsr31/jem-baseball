---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const roster = [
  { number: '00', name: 'Isaiah McPherson' },
  { number: '29', name: 'Sebastian Cobb' },
  { number: '33', name: 'John Cross' },
  { number: '34', name: 'Blake Jones' },
  { number: '35', name: 'Odie Hoover' },
  { number: '36', name: 'DJ Brown' },
  { number: '37', name: 'Julius Berrini' },
  { number: '38', name: 'Langston Miller' },
  { number: '39', name: 'David Sparkman' },
  { number: '40', name: 'Jeremiah Hampton' },
  { number: '41', name: 'Miles Merritt' },
  { number: '42', name: 'CJ Tate' },
  { number: '43', name: 'Tyrone Stevens' },
  { number: '45', name: 'Justin Horton' },
  { number: '46', name: 'Tristian Dixon' },
  { number: '48', name: 'Roman Rojas' },
];

const staff = ['Kyell Alexander', 'Nico Berrini', 'Jennifer Hoover', 'Tina Jones'];
---

<Layout title="11U Roster | JEM Baseball Training">
  <h1 class="page-title">11U Roster</h1>
  <p class="roster-season">Fall 2026</p>

  {
    /* TODO: give a player a real photo by adding `photo: `${base}/images/teams/11u/<file>.jpg``
       to their entry above and rendering <img src={p.photo} alt={p.name} /> in place of the
       placeholder below. */
  }
  <div class="roster-grid">
    {
      roster.map((p) => (
        <div class="roster-card">
          <div class="roster-card-photo">
            <span class="roster-card-icon" aria-hidden="true">
              📷
            </span>
          </div>
          <p class="roster-card-name">{p.name}</p>
          <p class="roster-card-number">#{p.number}</p>
        </div>
      ))
    }
  </div>

  <section class="roster-staff">
    <h2 class="roster-staff-title">Coaching Staff</h2>
    <p>{staff.join(' · ')}</p>
  </section>

  <div class="prose" style="text-align: center;">
    <p>
      Questions? Email
      <a href="mailto:jembaseballtraining@gmail.com">jembaseballtraining@gmail.com</a>
    </p>
    <p><a href={`${base}/teams`}>&larr; Back to Teams</a></p>
  </div>
</Layout>

<style>
  .roster-season {
    text-align: center;
    font-family: var(--font-sans);
    color: var(--jem-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: -1.25rem 0 2rem;
  }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    margin-bottom: 3rem;
  }

  .roster-card {
    text-align: center;
  }

  .roster-card-photo {
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    background: var(--jem-surface);
    border: 1px dashed var(--jem-gold);
    border-radius: 4px;
    margin-bottom: 0.6rem;
  }

  .roster-card-icon {
    font-size: 1.8rem;
    opacity: 0.6;
  }

  .roster-card-name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }

  .roster-card-number {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--jem-gold);
    letter-spacing: 0.05em;
  }

  .roster-staff {
    text-align: center;
    font-family: var(--font-sans);
    margin-bottom: 2.5rem;
  }

  .roster-staff-title {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--jem-gold);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 767px) {
    .roster-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .roster-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home">
    <p class="home-tagline">
      Chicagoland youth baseball organization promoting high quality instruction
      and baseball character development.
    </p>
  </div>
</Layout>

<style>
  .home {
    text-align: center;
  }

  .home-tagline {
    font-size: 1.5rem;
    max-width: 46rem;
    margin: 1.5rem auto 0;
  }

  @media (max-width: 767px) {
    .home-tagline {
      font-size: 1.2rem;
      margin-top: 1rem;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home">
    <img
      src={`${import.meta.env.BASE_URL}/images/jem-logo.jpg`}
      alt="JEM Baseball Training — Chicago, IL"
      class="home-logo"
      width="540"
      height="540"
    />
    <p class="home-tagline">
      Chicagoland youth baseball organization promoting high quality instruction
      and baseball character development.
    </p>
  </div>
</Layout>

<style>
  .home {
    text-align: center;
  }

  .home-logo {
    max-width: 500px;
    width: 85%;
    height: auto;
    margin: 1rem auto;
    display: block;
  }

  .home-tagline {
    font-size: 1.5rem;
    max-width: 46rem;
    margin: 1.5rem auto 0;
  }
</style>

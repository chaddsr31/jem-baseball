---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const pillars = [
  {
    img: `${base}/images/mission-pillar-1.png`,
    title: 'Fundamentals',
    text: 'Proper baseball technique and foundational concept of key baseball fundamentals.',
  },
  {
    img: `${base}/images/mission-pillar-2.png`,
    title: 'Quality',
    text: 'Efficiency starts with the quality of repetition — quality over quantity.',
  },
  {
    img: `${base}/images/mission-pillar-3.png`,
    title: 'Speed & Agility',
    text: 'Speed and agility training to enhance baseball skills.',
  },
  {
    img: `${base}/images/mission-pillar-4.png`,
    title: 'Positivity',
    text: 'Positive reinforcement and encouragement.',
  },
];
---

<Layout title="Mission | JEM Baseball Training">
  <h1 class="page-title">Mission</h1>

  <div class="prose mission-statement">
    <p>
      Providing exceptional baseball instruction, tailored academic enrichment,
      and creating opportunities for our players to serve the community.
    </p>
  </div>

  <img
    src={`${base}/images/mission-photo.jpg`}
    alt="JEM Baseball Training players"
    class="mission-photo"
  />

  <div class="pillars">
    {
      pillars.map((p) => (
        <div class="pillar">
          <img src={p.img} alt={p.title} loading="lazy" />
          <h2>{p.title}</h2>
          <p>{p.text}</p>
        </div>
      ))
    }
  </div>
</Layout>

<style>
  .mission-statement {
    text-align: center;
    font-size: 1.35rem;
  }

  .mission-photo {
    display: block;
    margin: 2.5rem auto;
    max-width: 640px;
    width: 100%;
    border-radius: 4px;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
    text-align: center;
  }

  .pillar img {
    max-width: 180px;
    margin: 0 auto 0.75rem;
    display: block;
  }

  .pillar h2 {
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--jem-orange);
    margin-bottom: 0.5rem;
  }

  .pillar p {
    font-size: 1rem;
  }
</style>

---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JEM Baseball Training',
  description =
    'Chicagoland youth baseball organization promoting high quality instruction and baseball character development.',
} = Astro.props;

const nav = [
  { href: '/mission', label: 'Mission' },
  { href: '/tryouts', label: 'Tryouts' },
  {
    href: '/teams',
    label: 'Teams',
    children: [
      { href: '/teams/8u', label: '8U' },
      { href: '/teams/9u', label: '9U' },
      { href: '/teams/11u', label: '11U' },
    ],
  },
  { href: '/founders', label: 'Founders' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/photo-albums', label: 'Photo Albums' },
  { href: '/community-service', label: 'Community Service' },
  { href: '/donate', label: 'Donate' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href={`${base}/images/jem-logo.jpg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <button
        type="button"
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span aria-hidden="true">☰</span>
      </button>

      <div class="nav-backdrop" hidden></div>

      <nav id="site-nav" class="site-nav" aria-label="Main">
        <button type="button" class="nav-close" aria-label="Close menu">
          <span aria-hidden="true">✕</span>
        </button>
        <a href={`${base}/`} class="nav-home">Home</a>
        {
          nav.map((item) =>
            item.children ? (
              <details class="nav-dropdown">
                <summary
                  aria-current={
                    item.children.some((c) => currentPath === `${base}${c.href}`)
                      ? 'page'
                      : undefined
                  }
                >
                  {item.label}
                </summary>
                <div class="nav-dropdown-menu">
                  {item.children.map((child) => (
                    <a
                      href={`${base}${child.href}`}
                      aria-current={currentPath === `${base}${child.href}` ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={`${base}${item.href}`}
                aria-current={currentPath === `${base}${item.href}` ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          )
        }
      </nav>
      <a href={`${base}/`} class="brand">
        <img src={`${base}/images/jem-wordmark.png`} alt="JEM Baseball Training — Est. 2015" />
      </a>
    </header>

    <script>
      const toggle = document.querySelector('.nav-toggle');
      const backdrop = document.querySelector('.nav-backdrop');
      const closeBtn = document.querySelector('.nav-close');

      const setOpen = (open) => {
        document.body.classList.toggle('nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        backdrop.hidden = !open;
        if (open) closeBtn.focus();
        else toggle.focus();
      };

      toggle.addEventListener('click', () => setOpen(true));
      closeBtn.addEventListener('click', () => setOpen(false));
      backdrop.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.classList.contains('nav-open')) setOpen(false);
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-heading">contact</p>
      <a href="mailto:jembaseballtraining@gmail.com" class="footer-email"
        >JEMBASEBALLTRAINING@GMAIL.COM</a
      >
      <p class="footer-heading">connect</p>
      <div class="footer-social">
        <a
          href="https://instagram.com/jembaseballtraining"
          target="_blank"
          rel="noopener"
          aria-label="Instagram">Instagram</a
        >
        <a
          href="https://www.facebook.com/jembaseballtraining/"
          target="_blank"
          rel="noopener"
          aria-label="Facebook">Facebook</a
        >
      </div>
      <form
        class="footer-signup"
        action="mailto:jembaseballtraining@gmail.com"
        method="get"
      >
        <p class="footer-signup-title">WANT TO TRAIN LIKE A JEM?</p>
        <input type="text" name="name" placeholder="Name" aria-label="Name" />
        <input
          type="email"
          name="email"
          placeholder="Email Address"
          aria-label="Email Address"
        />
        <button type="submit">SUBMIT</button>
      </form>
      <p class="footer-hashtag">#TRAINLIKEAJEM</p>
      <p class="footer-copy">
        ©{new Date().getFullYear()} JEM Baseball Training ·
        <a href="https://www.plcca.org" target="_blank" rel="noopener">PLCCA</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --jem-orange: #e8833a;
    --jem-gold: #c9a86a;
    --jem-bg: #000000;
    --jem-surface: #161616;
    --jem-border: #333333;
    --jem-text: #f2eee4;
    --jem-text-muted: #a39c92;
    --jem-on-accent: #000000;
    --font-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    --font-sans: 'Avenir Next', Avenir, 'Helvetica Neue', Arial, sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-serif);
    color: var(--jem-text);
    background: var(--jem-bg);
    line-height: 1.6;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.2;
  }

  a {
    color: var(--jem-orange);
  }

  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  /* Header */
  .site-header {
    text-align: center;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--jem-gold);
    font-family: var(--font-sans);
    font-size: 1.05rem;
  }

  .site-nav a {
    color: var(--jem-gold);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--jem-orange);
  }

  .nav-toggle,
  .nav-close,
  .nav-backdrop {
    display: none;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
    list-style: none;
    color: var(--jem-gold);
    letter-spacing: 0.02em;
    user-select: none;
    -webkit-user-select: none;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown summary::after {
    content: '▾';
    font-size: 0.7em;
    margin-left: 0.3em;
  }

  .nav-dropdown summary:hover,
  .nav-dropdown summary[aria-current='page'],
  .nav-dropdown[open] summary {
    color: var(--jem-orange);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0.6rem;
    display: flex;
    flex-direction: column;
    min-width: 7rem;
    background: var(--jem-surface);
    border: 1px solid var(--jem-gold);
    border-radius: 4px;
    padding: 0.4rem 0;
    z-index: 10;
  }

  .nav-dropdown-menu a {
    padding: 0.4rem 1.25rem;
    white-space: nowrap;
    text-align: center;
  }

  .brand img {
    max-width: 440px;
    width: 90%;
    height: auto;
    margin: 1.5rem auto 0;
    display: block;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--jem-gold);
    text-align: center;
    padding: 2rem 1rem 2.5rem;
    font-family: var(--font-sans);
  }

  .footer-email {
    color: var(--jem-text);
    text-decoration: none;
    letter-spacing: 0.08em;
    font-size: 0.95rem;
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 1rem 0;
  }

  .footer-heading {
    text-transform: lowercase;
    letter-spacing: 0.2em;
    color: var(--jem-gold);
    margin: 0.75rem 0 0.25rem;
    font-size: 0.9rem;
  }

  .footer-signup {
    margin: 1.5rem auto 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 34rem;
  }

  .footer-signup-title {
    flex-basis: 100%;
    letter-spacing: 0.1em;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .footer-signup input {
    padding: 0.5rem 0.75rem;
    background: var(--jem-surface);
    color: var(--jem-text);
    border: 1px solid var(--jem-gold);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .footer-signup input::placeholder {
    color: var(--jem-text-muted);
  }

  .footer-signup button {
    padding: 0.5rem 1.5rem;
    background: var(--jem-orange);
    color: var(--jem-on-accent);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .footer-hashtag {
    letter-spacing: 0.15em;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--jem-text-muted);
  }

  /* Shared page styles */
  .page-title {
    text-align: center;
    font-size: 2rem;
    margin: 1.5rem 0 2rem;
    letter-spacing: 0.04em;
  }

  .prose {
    max-width: 42rem;
    margin: 0 auto;
    font-size: 1.15rem;
  }

  .prose p + p {
    margin-top: 1rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin: 0.4rem 0.4rem 0 auto;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.5rem;
      line-height: 1;
      color: var(--jem-gold);
    }

    .nav-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      z-index: 20;
    }

    .nav-backdrop[hidden] {
      display: none;
    }

    /* Slide-over drawer */
    .site-nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(78vw, 300px);
      z-index: 30;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 3.5rem 0 2rem;
      background: var(--jem-surface);
      border-bottom: none;
      border-left: 1px solid var(--jem-gold);
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateX(100%);
      transition: transform 0.25s ease;
    }

    body.nav-open .site-nav {
      transform: translateX(0);
    }

    body.nav-open {
      overflow: hidden;
    }

    .nav-close {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 0.4rem;
      right: 0.4rem;
      width: 44px;
      height: 44px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1.3rem;
      line-height: 1;
      color: var(--jem-gold);
    }

    .site-nav > a,
    .nav-dropdown summary {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding: 0 1.5rem;
    }

    .nav-dropdown-menu {
      position: static;
      transform: none;
      margin-top: 0;
      min-width: 0;
      border: none;
      border-radius: 0;
      padding: 0;
      background: var(--jem-bg);
    }

    .nav-dropdown-menu a {
      text-align: left;
      padding: 0 1.5rem 0 2.5rem;
      min-height: 44px;
      display: flex;
      align-items: center;
    }

    .site-header {
      border-bottom: 1px solid var(--jem-gold);
    }

    .brand img {
      margin-top: 0.25rem;
      margin-bottom: 1rem;
    }

    main {
      padding: 1.25rem 1.25rem 3rem;
    }

    .page-title {
      font-size: 1.6rem;
      margin: 1rem 0 1.5rem;
    }

    .prose {
      font-size: 1.05rem;
    }

    .footer-signup input,
    .footer-signup button {
      width: 100%;
      min-height: 44px;
    }

    .footer-social a,
    .footer-email {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }
</style>
